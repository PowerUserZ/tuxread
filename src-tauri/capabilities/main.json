{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "What the main window may call: TuxRead's own commands and the file dialogs.",
  "windows": ["main"],
  "permissions": [
    "allow-list-sources",
    "allow-open-image",
    "allow-open-disk",
    "allow-list-dir",
    "allow-stat",
    "allow-copy",
    "allow-cancel-job",
    "allow-job-report",
    "allow-save-report",
    "allow-diagnostics",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
